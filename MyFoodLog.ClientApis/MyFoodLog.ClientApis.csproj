<Project Sdk="Microsoft.NET.Sdk">
    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
      <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
      <PackageReference Include="Newtonsoft.Json" />
      <PackageReference Include="NSwag.MSBuild" >
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="OpenApiSpecifications" />
    </ItemGroup>

    <Target Name="NSwag" BeforeTargets="CoreCompile">
        <Exec ConsoleToMsBuild="true" WorkingDirectory="$(ProjectDir)" Command="$(NSwagExe_Net80) openapi2csclient /input:OpenApiSpecifications/grocy.json /classname:GrocyClient /namespace:MyFoodLog.ClientApis /GenerateClientInterfaces:true /ClientBaseClass:MyFoodLog.ClientApis.BaseClients.APIKeyBaseClient /InjectHttpClient:false /UseHttpClientCreationMethod:true /GenerateClientClasses:true /output:GrocyClient.cs /contractsoutput:Interfaces/IgrocyClient.cs /GenerateContractsOutput:true /ContractsNamespace:MyFoodLog.ClientApis.Interfaces /excludedTypeNames:ExposedEntity_IncludingUserEntities_NotIncludingNotEditable" />
    </Target>
    
</Project>
